# ---- Required ----
mongoose_url=your_mongodb_connection_string
jwt_secret_key=your_jwt_secret        # NOTE: code reads jwt_secret_key (not JWT_SECRET)

# ---- Judge0 (code execution) ----
judge=your_judge0_api_key

# ---- Google Gemini (AI chat) ----
GEMINI_API_KEY=your_gemini_api_key

# ---- Cloudinary (video solutions) ----
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ---- Redis (OPTIONAL — server runs fine without these) ----
host_link=your_redis_host
redis_pass=your_redis_password
redis_port=your_redis_port

# PORT is provided automatically by Render
